MONAD_RPC=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
INFR_CONTRACT=0xD1758e1205f79C4F2dAc8f6b7D32A2E517835851
INFR_DECIMALS=18
INFR_PRICE_PER_CALL=10

# Provider wallet — receives INFR payments (put in manifest)
RUNNER_WALLET=0x225fd0b9d011c8bbffd0f0c6f854cd23b99b6af7

# ERC-8004 Trustless Agents (pre-deployed on Monad testnet)
ERC8004_IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION_REGISTRY=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63

# Agent staking (native MON bond locked at listing time)
# Deploy with: cd contracts && forge script script/DeployStaking.s.sol --rpc-url $MONAD_RPC --private-key $DEPLOYER_PRIVATE_KEY --broadcast
AGENT_STAKING_CONTRACT=
# Bond amount (in MON) the provider locks when serving with --stake
AGENT_STAKE=0.01
# Minimum bond the platform expects (informational, enforced on-chain)
MIN_STAKE=0.01

# Platform sync — provider lists agent for discovery
INFERNET_PLATFORM_URL=http://localhost:3000
PLATFORM_PUBLISH_KEY=dev-publish-key-change-me
PUBLISH_TO_PLATFORM=1

# Neon Postgres for agent listings (set in frontend/.env.local)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Gateway — browser inference proxies through this (pip install -e ".[bridge]" && infernet-gateway)
INFERNET_GATEWAY_URL=http://127.0.0.1:8787

# Provider key — mints ERC-8004 agent NFT (keep secret, never commit)
# AGENT_OWNER_PRIVATE_KEY=0xYourProviderPrivateKey

# Auto-register on `infernet serve --register-erc8004` or REGISTER_ERC8004=1
# REGISTER_ERC8004=0

# User wallet — pays for inference (keep secret, never commit)
PAYER_PRIVATE_KEY=4942b64a8f52f5e17599df781d62bc1aab9ac71f888c103f1c899e1c08cb14ee

# WSL deploy only — do not commit
# DEPLOYER_PRIVATE_KEY=0xYourDeployerPrivateKey